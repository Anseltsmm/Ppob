# ============================================================
# Aplikasi PPOB - Template Konfigurasi Lingkungan
# ============================================================
# Cara pakai:
#   cp .env.example .env
#   php artisan key:generate
#
# Catatan:
# - Kredensial OkeConnect & TriPay DISIMPAN DI DATABASE (menu Pengaturan admin),
#   BUKAN di file ini.
# - Order diproses via QUEUE — pastikan QUEUE_CONNECTION=database dan
#   jalankan queue worker (lihat README).
# ============================================================

APP_NAME="PPOB"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.azkia.cloud
# APP_URL harus diisi dengan domain aplikasi Anda (tanpa garis miring di akhir).

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------- DATABASE ----------
# VPS: gunakan MySQL/MariaDB. Shared hosting: isi kredensial dari panel hosting.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ppob
DB_USERNAME=ppob
DB_PASSWORD=

# ---------- SESSION & QUEUE ----------
# Aplikasi ini WAJIB memakai database untuk session & queue (order diproses async).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------- MAIL (opsional) ----------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- LAYANAN LAIN ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
